# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local". Only variable NAMES belong in this file.
#
# In production, set these same variables in the Vercel dashboard
# (Project → Settings → Environment Variables).

# --- Public site URL (used for canonical URLs, sitemap, Open Graph) ---
# Local: http://localhost:3000  |  Production: https://your-domain
NEXT_PUBLIC_SITE_URL=

# --- Supabase (added in Milestone 4) ---
# Found in Supabase Dashboard → Project Settings → API.
# The two NEXT_PUBLIC_ values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Full admin access to the database — bypasses Row Level Security.
# Must NEVER be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend email (added in Milestone 7) ---
RESEND_API_KEY=
# The "from" address emails are sent from (must be a verified domain in Resend).
EMAIL_FROM=
# Where new quote-request notifications are delivered.
QUOTE_NOTIFICATION_EMAIL=
